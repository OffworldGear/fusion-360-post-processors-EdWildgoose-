(O6008 - LASER NT TOOL LENGTH MACRO - REV C 2026-09-29)
(MACHINE: BROTHER SPEEDIO S500X2 / C00 CONTROLLER)
(SETTER:  BLUM LASER NT - V5DE CYCLES O8602 / O8603)
(REV C: B2 COMPARE-ONLY MODE [BLUM CONTROL MODE, NO WRITES])
(REV C: #580 IN-PROGRESS FLAG WHILE NOMINAL DIA IS IN #13000+T)
(REV C: G90 RESTORED ON EXIT. BLUM EXITS IN G91 + G49)
(REV C: ALARMS 9101-9108, MESSAGES MAX 20 CHARACTERS)
(REV C: NO NESTED PARENTHESES IN COMMENTS)
(================================================================)
(RULES:)
(- CALL FROM A MAIN PROGRAM ONLY. THIS MACRO + BLUM USES ALL 4)
(  G65 NESTING LEVELS ALLOWED BY THE C00.)
(- MACHINE UNIT MUST BE METRIC [BLUM ERROR E18].)
(- USES PERSISTENT VARIABLES #580 #581 #582.)
(================================================================)
(CALL FORMAT:)
(  G65 P6008 B.. T.. D.. C.. K.. S.. Q.. A.. R.. Z.. X.. M..)
(ARGUMENTS:)
(  B #2  MODE 3 = MEASURE AND WRITE LENGTH [DEFAULT])
(        MODE 2 = COMPARE ONLY WITH TABLE LENGTH, WRITES NOTHING)
(  T #20 TOOL NUMBER [DEFAULT: SPINDLE TOOL #3700])
(  D #7  NOMINAL TOOL DIAMETER MM [REQUIRED, 0.1 TO 24.0])
(  C #3  NUMBER OF FLUTES [DEFAULT 4])
(  K #6  TOOL TYPE:)
(        -3 = MEASURE ON CENTRE WITH O8602 [DRILLS AND ALL)
(             POINTED OR PROFILED TOOLS])
(        -4 = T-SLOT CUTTER)
(        -1 OR K GE D/2 = BALL NOSE [X = 0])
(        0 OR OMITTED = FLAT END MILL)
(        0 LT K LT D/2 = BULLNOSE WITH CORNER RADIUS K)
(  S #19 SPINDLE RPM [DEFAULT AND MINIMUM 3000])
(  Q #17 COMPARE TOLERANCE MM FOR B2 [DEFAULT 0.025])
(  A #1  REPEAT MEASUREMENTS [DEFAULT 3])
(  R #18 REPEAT SPREAD MM [0.0004 CENTRIC, 0.010 MILLS])
(  Z #26 BLUM Z ARGUMENT, UNUSED FOR LENGTH [DEFAULT 0.5])
(  X #24 RADIAL MEASURING POSITION MM [DEFAULT BY TYPE])
(  M #13 1 = LEAVE SPINDLE RUNNING, 0 = STOP [DEFAULT])
(RESULTS [B2]: #581 = TOOL, #582 = LASER MINUS TABLE LENGTH)
(================================================================)
(--- STEP 1: ARGUMENTS ---)
IF [#20 NE #0] GOTO 10
#20 = #3700 (DEFAULT TO SPINDLE TOOL)
N10
#27 = FIX[#20]
IF [#27 LE 0] GOTO 9101
IF [#27 GT 99] GOTO 9101
(MODE B)
IF [#2 NE #0] GOTO 12
#2 = 3.
N12
IF [#2 EQ 3.] GOTO 14
IF [#2 EQ 2.] GOTO 14
GOTO 9108
N14
(NOMINAL DIAMETER)
IF [#7 EQ #0] GOTO 9102
IF [#7 LE 0.] GOTO 9102
IF [#7 GT 24.] GOTO 9106
(COMPARE MODE NEEDS A VALID TABLE LENGTH - MUST MATCH O8671 #111/#110)
IF [#2 NE 2.] GOTO 16
IF [#[11000 + #27] LT 50.] GOTO 9107
IF [#[11000 + #27] GT 200.] GOTO 9107
N16
(FLUTES)
IF [#3 EQ #0] GOTO 25
IF [#3 GT 0.] GOTO 26
N25
#3 = 4.
N26
(SPINDLE SPEED, MINIMUM 3000 FOR NT)
IF [#19 EQ #0] GOTO 30
IF [#19 LT 3000.] GOTO 30
GOTO 35
N30
#19 = 3000.
N35
(COMPARE TOLERANCE Q)
IF [#17 EQ #0] GOTO 40
IF [#17 LE 0.] GOTO 40
GOTO 45
N40
#17 = 0.025
N45
(REPEATS A)
IF [#1 NE #0] GOTO 46
#1 = 3.
N46
(SPINDLE EXIT M)
IF [#13 NE #0] GOTO 47
#13 = 0.
N47
(--- STEP 2: TOOL IN SPINDLE ---)
IF [#3700 EQ #27] GOTO 20
G91 G28 Z0. (Z TO REFERENCE BEFORE CANCELLING LENGTH COMP)
G90 G49
T#27 M6
M159
N20
(--- STEP 3: TOOL TYPE ---)
IF [#6 EQ #0] GOTO 60 (FLAT END MILL IF OMITTED)
IF [ABS[#6 - [-3.]] LT 0.01] GOTO 500 (ON CENTRE VIA O8602)
IF [ABS[#6 - [-4.]] LT 0.01] GOTO 85 (T-SLOT CUTTER)
IF [#6 EQ 0.] GOTO 60 (FLAT END MILL)
IF [#6 LT 0.] GOTO 70 (BALL NOSE)
IF [#6 GE [#7 / 2.]] GOTO 70 (TREATED AS BALL NOSE)
GOTO 80 (BULLNOSE)
(FLAT END MILL: X = 80 PERCENT OF RADIUS)
N60
IF [#24 NE #0] GOTO 61
#24 = [#7 / 2.] * 0.8
N61
IF [#26 NE #0] GOTO 62
#26 = 0.5
N62
IF [#18 NE #0] GOTO 600
#18 = 0.01
GOTO 600
(BALL NOSE: X = 0)
N70
IF [#24 NE #0] GOTO 71
#24 = 0.
N71
IF [#26 NE #0] GOTO 72
#26 = 0.5
N72
IF [#18 NE #0] GOTO 600
#18 = 0.01
GOTO 600
(BULLNOSE: X ON THE FLAT BOTTOM INSIDE THE CORNER RADIUS)
N80
IF [#26 NE #0] GOTO 81
#26 = 0.5
N81
IF [#18 NE #0] GOTO 82
#18 = 0.01
N82
IF [#24 NE #0] GOTO 600
#24 = [#7 / 2.] - #6 - 0.5
IF [#24 GE 0.1] GOTO 600
#24 = [[#7 / 2.] - #6] * 0.8
IF [#24 GE 0.] GOTO 600
#24 = 0.
GOTO 600
(T-SLOT CUTTER)
N85
IF [#26 NE #0] GOTO 86
#26 = 0.5
N86
IF [#18 NE #0] GOTO 87
#18 = 0.01
N87
IF [#24 NE #0] GOTO 600
#24 = [#7 / 2.] * 0.7
GOTO 600
(--- STEP 4A: ON CENTRE VIA O8602 ---)
N500
IF [#18 NE #0] GOTO 501
#18 = 0.0004
N501
M3 S#19
M159
G4 X1.5
(S = BLUM LENGTH TOLERANCE, ONLY USED IN B2 COMPARE MODE)
G65 P8602 H#27 B#2 S#17 A#1 R#18
G90 (BLUM EXITS IN G91)
#[13000 + #27] = 0.
M159
GOTO 800
(--- STEP 4B: MILLS VIA O8603, NOMINAL DIA NEEDED FOR POSITIONING ---)
N600
M3 S#19
M159
G4 X1.5
#580 = #27 (FLAG: NOMINAL DIAMETER IS IN #13000+T)
#[13000 + #27] = #7
M159
G65 P8603 H#27 D#27 B#2 E1. M-1. Z#26 X#24 C#3 S#17 Q#17 A#1 R#18
G90 (BLUM EXITS IN G91)
#[13000 + #27] = 0.
#580 = 0.
M159
(--- STEP 5: RESULT ---)
N800
IF [#100 NE 0] GOTO 9103
IF [#2 NE 2.] GOTO 810
#581 = #27
#582 = #126 - #[11000 + #27] (LASER MINUS TABLE LENGTH)
N810
IF [#13 NE 0.] GOTO 900
M5
N900
G90
M159
M99
(================================================================)
(ALARMS 9101-9108)
(================================================================)
N9101
#3000=101(INVALID TOOL NUMBER)
N9102
#3000=102(DIA D MISSING)
N9103
#[13000 + #27] = 0.
#580 = 0.
M159
M5
#3000=103(BLUM MEAS FAILED)
N9106
#3000=106(DIA OVER 24MM)
N9107
#3000=107(NO VALID TOOL LEN)
N9108
#3000=108(BAD MODE B)
