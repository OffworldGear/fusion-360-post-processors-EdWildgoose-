(O6008 - LASER NT TOOL LENGTH MEASURING MACRO)
(MACHINE: BROTHER SPEEDIO S500X2 / C00 CONTROLLER)
(SETTER:  BLUM LASER NT NANO)
(REV B: IF-GOTO ONLY. NO ONE-LINE IF ASSIGNMENTS)
(REV B: REMOVED 50MM LENGTH GATE. BLUM #111 CHECK APPLIES)
(================================================================)
(CALL FORMAT:)
(  G65 P6008 T.. D.. C.. K.. S.. Q.. A.. R.. Z.. X.. M..         )
(                                                                )
(ARGUMENT DEFINITIONS:)
(  T = TOOL NUMBER [#20] (OPTIONAL: DEFAULTS TO ACTIVE SPINDLE #3700))
(  D = NOMINAL TOOL DIAMETER [#7] (REQUIRED: 0.1 TO 24.0 MM))
(  C = NUMBER OF CUTTING EDGES / FLUTES [#3] (DEFAULT: 4.0))
(  K = TOOL TYPE / CORNER RADIUS [#6] (DEFAULT: 0.0))
(        K = -3.0: CENTRIC TOOL - DRILL / TAP / REAMER VIA P8602)
(        K = -4.0: T-SLOT CUTTER VIA P8603)
(        K = -1.0 OR K >= D/2: BALL NOSE MILL VIA P8603)
(        K = 0.0 OR OMITTED: FLAT END MILL VIA P8603)
(        0.0 < K < D/2: BULLNOSE MILL WITH RADIUS K VIA P8603)
(  S = SPINDLE SPEED RPM [#19] (DEFAULT: 3000, MINIMUM: 3000 FOR NT))
(  Q = LENGTH TOLERANCE MM [#17] (DEFAULT: 0.025 MM))
(  A = REPEAT MEASUREMENT PASSES [#1] (DEFAULT: 3.0))
(  R = REPEAT SPREAD TOLERANCE MM [#18])
(        DEFAULT: 0.0004 FOR CENTRIC P8602, 0.010 FOR MILL P8603)
(  Z = AXIAL MEASURING APPROACH HEIGHT [#26] (DEFAULT: 0.5 MM))
(  X = CUSTOM RADIAL POSITION [#24] (OPTIONAL OVERRIDE))
(  M = SPINDLE SHUTDOWN ON EXIT [#13] (0=STOP M5, 1=LEAVE RUNNING))
(================================================================)
(--- STEP 1: PARAMETER VALIDATION & DEFAULTS ---)
(TOOL NUMBER ASSIGNMENT)
IF [#20 NE #0] GOTO 10
#20 = #3700 (DEFAULT TO ACTIVE SPINDLE TOOL)
N10
#27 = FIX[#20] (CLEAN INTEGER TOOL NUMBER STORED IN #27)
IF [#27 LE 0] GOTO 9001 (ALARM: INVALID TOOL NUMBER)
IF [#27 GT 99] GOTO 9001 (ALARM: INVALID TOOL NUMBER)
(VERIFY ACTIVE TOOL IN SPINDLE)
IF [#3700 EQ #27] GOTO 20
T#27 M6 (PERFORM TOOL CHANGE IF REQUESTED TOOL NOT IN SPINDLE)
M159
N20
(NOMINAL DIAMETER VALIDATION)
IF [#7 EQ #0] GOTO 9002 (ALARM: NOMINAL DIAMETER D IS MANDATORY)
IF [#7 LE 0.0] GOTO 9002
IF [#7 GT 24.0] GOTO 9006 (ALARM: DIAMETER EXCEEDS 24MM LASER APERTURE)
(FLUTE COUNT)
IF [#3 EQ #0] GOTO 25
IF [#3 GT 0.0] GOTO 26
N25
#3 = 4.0 (DEFAULT TO 4 FLUTES)
N26
(SPINDLE SPEED - CLAMPED TO MIN 3000 FOR BLUM NT)
IF [#19 EQ #0] GOTO 30
IF [#19 LT 3000.0] GOTO 30
GOTO 35
N30
#19 = 3000.0 (BLUM NT MANDATORY MINIMUM RPM)
N35
(LENGTH TOLERANCE Q)
IF [#17 EQ #0] GOTO 40
IF [#17 LE 0.0] GOTO 40
GOTO 45
N40
#17 = 0.025 (DEFAULT 25 MICRONS / 0.001 INCH)
N45
(REPEAT COUNT A)
IF [#1 NE #0] GOTO 46
#1 = 3.0
N46
(SPINDLE EXIT M)
IF [#13 NE #0] GOTO 47
#13 = 0.0 (DEFAULT SPINDLE STOP ON EXIT)
N47
(--- STEP 2: CENTRIC VS NON-CENTRIC TOOL BRANCHING ---)
IF [#6 EQ #0] GOTO 60 (FLAT END MILL IF OMITTED)
IF [ABS[#6 - [-3.0]] LT 0.01] GOTO 500 (CENTRIC: DRILL/TAP/REAMER)
IF [ABS[#6 - [-4.0]] LT 0.01] GOTO 85 (T-SLOT CUTTER)
IF [#6 EQ 0.0] GOTO 60 (FLAT END MILL)
IF [#6 LT 0.0] GOTO 70 (BALL NOSE MILL)
IF [#6 GE [#7 / 2.0]] GOTO 70 (TREATED AS BALL NOSE)
GOTO 80 (BULLNOSE MILL)
(--- STEP 3: NON-CENTRIC RADIAL OFFSET & HEIGHT CALCULATION ---)
(FLAT END MILL: X = 80% RADIUS, Z = 0.5MM)
N60
IF [#24 NE #0] GOTO 61
#24 = [#7 / 2.0] * 0.80
N61
IF [#26 NE #0] GOTO 62
#26 = 0.5
N62
IF [#18 NE #0] GOTO 600
#18 = 0.010
GOTO 600
(BALL NOSE MILL: X = 0.0, Z = 0.5MM)
N70
IF [#24 NE #0] GOTO 71
#24 = 0.0
N71
IF [#26 NE #0] GOTO 72
#26 = 0.5
N72
IF [#18 NE #0] GOTO 600
#18 = 0.010
GOTO 600
(BULLNOSE MILL: X = RAD - CRAD - 0.5MM, Z = 0.5MM)
N80
IF [#26 NE #0] GOTO 81
#26 = 0.5
N81
IF [#18 NE #0] GOTO 82
#18 = 0.010
N82
IF [#24 NE #0] GOTO 600
#24 = [#7 / 2.0] - #6 - 0.50
IF [#24 GE 0.10] GOTO 600
#24 = [[#7 / 2.0] - #6] * 0.80
IF [#24 GE 0.0] GOTO 600
#24 = 0.0
GOTO 600
(T-SLOT CUTTER: X MIDPOINT OR PASSED X, Z = 0.5MM)
N85
IF [#26 NE #0] GOTO 86
#26 = 0.5
N86
IF [#18 NE #0] GOTO 87
#18 = 0.010
N87
IF [#24 NE #0] GOTO 600
#24 = [#7 / 2.0] * 0.70
GOTO 600
(--- STEP 4A: CENTRIC TOOL MEASUREMENT VIA P8602 ---)
N500
IF [#18 NE #0] GOTO 501
#18 = 0.0004 (BLUM CENTRIC REPEAT SPREAD TOLERANCE)
N501
M3 S#19
M159 (FLUSH BROTHER LOOKAHEAD BUFFER)
G4 X1.5 (SETTLE SPINDLE RPM DYNAMICS)
(EXECUTE BLUM CENTRIC LENGTH MEASUREMENT MACRO O8602)
G65 P8602 H#27 B3. S0.002 A#1 R#18
(ENSURE CUTTER COMP GEOMETRY IS ZERO)
#[13000 + #27] = 0.0000
M159
GOTO 800
(--- STEP 4B: NON-CENTRIC TOOL MEASUREMENT VIA P8603 ---)
N600
M3 S#19
M159 (FLUSH BROTHER LOOKAHEAD BUFFER)
G4 X1.5 (SETTLE SPINDLE RPM DYNAMICS)
(INJECT NOMINAL DIAMETER INTO CUTTER COMP)
(NOTE: IF BLUM ALARMS INSIDE O8603 THIS STAYS AT NOMINAL)
(THE POST ZEROS #13000+T AT EVERY TOOL CHANGE TO COVER THIS)
#[13000 + #27] = #7 (INJECT NOMINAL DIA INTO GEOMETRY COMP)
M159 (SYNCHRONIZE SYSTEM REGISTERS)
(EXECUTE BLUM MEASUREMENT MACRO O8603: B3=MEASURE LEN, E1=LENGTH ONLY)
G65 P8603 H#27 D#27 B3. E1.0 M-1.0 Z#26 X#24 C#3 Q#17 A#1 R#18
(CRITICAL - ZERO CUTTER COMP IMMEDIATELY)
#[13000 + #27] = 0.0000 (RESET CUTTER COMP GEOMETRY TO ZERO)
M159 (SYNCHRONIZE LOOKAHEAD BEFORE ANY MOTION)
(--- STEP 5: POST-MEASUREMENT VERIFICATION & SAFETY ---)
N800
(VERIFY BLUM RETURN STATUS: #100 MUST BE 0)
IF [#100 NE 0] GOTO 9003 (BLUM INTERNAL ERROR TRIGGERED)
(--- STEP 6: SPINDLE CONTROL & CLEAN EXIT ---)
IF [#13 NE 0.0] GOTO 900 (KEEP RUNNING IF M1 PROGRAMMED)
M5 (STOP SPINDLE)
N900
M159
M99 (RETURN TO CALLING PART PROGRAM)
(================================================================)
(ERROR HANDLERS & ALARM DISPATCHING)
(================================================================)
N9001
#3000 = 1 (INVALID TOOL NUMBER PROGRAMMED)
N9002
#3000 = 2 (NOMINAL TOOL DIA D MANDATORY)
N9003
(BLUM FAILED - ZERO OFFSET TABLE BEFORE MACHINE ALARM)
#[13000 + #27] = 0.0000
M159
M5
#3000 = 3 (BLUM LASER MEASUREMENT FAILED)
N9006
#3000 = 6 (TOOL DIA OVER 24MM LASER LIMIT)
