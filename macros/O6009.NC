(O6009 - IN-CYCLE DYNAMIC WEAR & RUNOUT MEASURING MACRO)
(MACHINE: BROTHER SPEEDIO S500X2 / C00 CONTROLLER)
(SETTER:  BLUM LASER NT NANO)
(================================================================)
(CALL FORMAT:)
(  G65 P6009 T.. D.. C.. K.. S.. Q.. U.. A.. R.. Z.. X.. M..     )
(                                                                )
(ARGUMENT DEFINITIONS:)
(  T = TOOL NUMBER [#20] (OPTIONAL: DEFAULTS TO ACTIVE SPINDLE #3700))
(  D = NOMINAL TOOL DIAMETER [#7] (REQUIRED: 0.1 TO 24.0 MM))
(  C = NUMBER OF CUTTING EDGES / FLUTES [#3] (DEFAULT: 4.0))
(  K = TOOL CORNER RADIUS / TYPE [#6] (DEFAULT: 0.0 = FLAT MILL))
(        K = 0.0 OR OMITTED: FLAT END MILL)
(        K = -3.0: CENTRIC TOOL / DRILL (MARGIN WEAR MEASUREMENT))
(        K = -4.0: T-SLOT CUTTER (BLADE WEAR MEASUREMENT))
(        K < 0.0 OR K >= D/2: BALL NOSE / LOLLIPOP EQUATOR)
(        0.0 < K < D/2: BULLNOSE MILL WITH CORNER RADIUS K)
(  S = SPINDLE SPEED RPM [#19] (DEFAULT: 3000, MINIMUM: 3000 FOR NT))
(  Q = MAX ALLOWABLE RUNOUT TOLERANCE MM [#17] (DEFAULT: 0.025 MM))
(  U = MAX ALLOWABLE DIAMETER WEAR LIMIT MM [#21] (DEFAULT: 0.100 MM))
(  A = REPEAT MEASUREMENT PASSES [#1] (DEFAULT: 3.0))
(  R = REPEAT SPREAD TOLERANCE MM [#18] (DEFAULT: 0.010 MM))
(  Z = CUSTOM AXIAL MEASURING HEIGHT [#26] (OPTIONAL OVERRIDE))
(  X = CUSTOM RADIAL POSITION [#24] (OPTIONAL OVERRIDE))
(  M = SPINDLE SHUTDOWN ON EXIT [#13] (0=STOP M5, 1=LEAVE RUNNING))
(================================================================)

(--- STEP 1: PARAMETER VALIDATION & DEFAULTS ---)
(TOOL NUMBER ASSIGNMENT)
IF [#20 NE #0] GOTO 10
#20 = #3700 (DEFAULT TO ACTIVE SPINDLE TOOL)
N10
#27 = FIX[#20] (CLEAN INTEGER TOOL NUMBER STORED IN #27)
IF [#27 LE 0] GOTO 9001 (ALARM: INVALID TOOL NUMBER)
IF [#27 GT 99] GOTO 9001 (ALARM: INVALID TOOL NUMBER)

(VERIFY ACTIVE TOOL IN SPINDLE)
IF [#3700 EQ #27] GOTO 20
T#27 M6 (PERFORM TOOL CHANGE IF REQUESTED TOOL NOT IN SPINDLE)
M159
N20

(NOMINAL DIAMETER VALIDATION)
IF [#7 EQ #0] GOTO 9002 (ALARM: NOMINAL DIAMETER D IS MANDATORY)
IF [#7 LE 0.0] GOTO 9002
IF [#7 GT 24.0] GOTO 9006 (ALARM: DIAMETER EXCEEDS 24MM LASER APERTURE)

(FLUTE COUNT)
IF [#3 EQ #0] GOTO 25
IF [#3 GT 0.0] GOTO 26
N25
#3 = 4.0 (DEFAULT TO 4 FLUTES)
N26

(SPINDLE SPEED - CLAMPED TO MIN 3000 FOR BLUM NT)
IF [#19 EQ #0] GOTO 30
IF [#19 LT 3000.0] GOTO 30
GOTO 35
N30
#19 = 3000.0 (BLUM NT MANDATORY MINIMUM RPM)
N35

(RUNOUT TOLERANCE Q)
IF [#17 EQ #0] GOTO 40
IF [#17 LE 0.0] GOTO 40
GOTO 45
N40
#17 = 0.025 (DEFAULT 25 MICRONS / 0.001 INCH)
N45

(MAXIMUM ALLOWABLE DIAMETER WEAR LIMIT U)
IF [#21 EQ #0] GOTO 50
IF [#21 LE 0.0] GOTO 50
GOTO 55
N50
#21 = 0.100 (DEFAULT MAX DIAMETER WEAR 0.100 MM)
N55
#14 = #21 / 2.0 (RADIAL WEAR TOLERANCE PASSED TO O8603 T PARAMETER)

(REPEAT COUNT A, SPREAD R, EXIT M)
IF [#1 NE #0] GOTO 46
#1 = 3.0
N46
IF [#18 NE #0] GOTO 47
#18 = 0.010
N47
IF [#13 NE #0] GOTO 48
#13 = 0.0 (DEFAULT SPINDLE STOP ON EXIT)
N48

(--- STEP 2: DYNAMIC Z AND X GEOMETRY CALCULATION ---)
(CORNER RADIUS & TOOL TYPE BRANCHING)
IF [#6 EQ #0] GOTO 60 (FLAT END MILL IF OMITTED)
IF [#6 EQ 0.0] GOTO 60 (FLAT END MILL)
IF [ABS[#6 - [-3.0]] LT 0.01] GOTO 51 (DRILL / CENTRIC TOOL)
IF [ABS[#6 - [-4.0]] LT 0.01] GOTO 52 (T-SLOT CUTTER)
IF [#6 LT 0.0] GOTO 70 (BALL NOSE / LOLLIPOP EQUATOR)
IF [#6 GE [#7 / 2.0]] GOTO 70 (TREATED AS BALL NOSE)
GOTO 80 (BULLNOSE MILL)

(DRILL: Z = CONE HEIGHT + 0.5MM MARGIN, X = 0.0)
N51
IF [#26 NE #0] GOTO 53
#26 = [[#7 / 2.0] / TAN[59.0]] + 0.50
N53
IF [#24 NE #0] GOTO 54
#24 = 0.0
N54
GOTO 100

(T-SLOT CUTTER: Z = 1.5MM BLADE CENTER, X = 80% RADIUS)
N52
IF [#26 NE #0] GOTO 56
#26 = 1.50
N56
IF [#24 NE #0] GOTO 57
#24 = [#7 / 2.0] * 0.80
N57
GOTO 100

(FLAT END MILL: Z = 15% OF DIA CLAMPED 0.08 TO 0.50MM, X = 80% RADIUS)
N60
IF [#26 NE #0] GOTO 65
#26 = #7 * 0.15
IF [#26 GE 0.08] GOTO 61
#26 = 0.08
N61
IF [#26 LE 0.50] GOTO 65
#26 = 0.50
N65
IF [#24 NE #0] GOTO 66
#24 = [#7 / 2.0] * 0.80
N66
GOTO 100

(BALL NOSE / LOLLIPOP: Z = EQUATOR RADIUS, X = 0.0)
N70
IF [#26 NE #0] GOTO 71
#26 = #7 / 2.0
N71
IF [#24 NE #0] GOTO 72
#24 = 0.0
N72
GOTO 100

(BULLNOSE MILL: Z = CRAD + 0.3MM BUFFER, X = RAD - CRAD - 0.5MM)
N80
IF [#26 NE #0] GOTO 81
#26 = #6 + 0.30
N81
IF [#24 NE #0] GOTO 100
#24 = [#7 / 2.0] - #6 - 0.50
IF [#24 GE 0.10] GOTO 100
#24 = [[#7 / 2.0] - #6] * 0.80
IF [#24 GE 0.0] GOTO 100
#24 = 0.0

N100
(--- STEP 3: SPINDLE START, LOOKAHEAD FLUSH & SETTLE ---)
M3 S#19
M159 (FLUSH BROTHER LOOKAHEAD BUFFER)
G4 X1.5 (SETTLE SPINDLE RPM DYNAMICS)

(--- STEP 4: INJECT NOMINAL DIAMETER INTO CUTTER COMP ---)
#[13000 + #27] = #7 (INJECT NOMINAL DIA INTO GEOMETRY COMP)
M159 (SYNCHRONIZE SYSTEM REGISTERS)

(--- STEP 5: EXECUTE BLUM MEASUREMENT MACRO O8603 ---)
(B1.0 = WEAR CHECK, E2.0 = RADIUS ONLY, M-1.0 = FRONT/ONE SIDE)
G65 P8603 H#27 D#27 B1.0 E2.0 M-1.0 Z#26 X#24 C#3 Q#17 T#14 A#1 R#18

(--- STEP 6: CRITICAL - ZERO CUTTER COMP IMMEDIATELY ---)
#[13000 + #27] = 0.0000 (RESET CUTTER COMP GEOMETRY TO ZERO)
M159 (SYNCHRONIZE LOOKAHEAD BEFORE ANY MOTION)

(--- STEP 7: POST-MEASUREMENT VERIFICATION & SAFETY ---)
(VERIFY BLUM RETURN STATUS: #100 MUST BE 0)
IF [#100 NE 0] GOTO 9003 (BLUM INTERNAL ERROR TRIGGERED)

(READ MEASURED DIAMETER WEAR STORED IN OFFSET TABLE)
#28 = #[12000 + #27]
IF [ABS[#28] GT #21] GOTO 9004 (WEAR EXCEEDS ALLOWABLE LIMIT)

(--- STEP 8: SPINDLE CONTROL & CLEAN EXIT ---)
IF [#13 NE 0.0] GOTO 200 (KEEP RUNNING IF M1 PROGRAMMED)
M5 (STOP SPINDLE)
N200
M99 (RETURN TO CALLING PART PROGRAM)

(================================================================)
(ERROR HANDLERS & ALARM DISPATCHING)
(================================================================)
N9001
#3000 = 1 (INVALID TOOL NUMBER PROGRAMMED)

N9002
#3000 = 2 (NOMINAL TOOL DIA D MANDATORY)

N9003
(BLUM FAILED - ZERO OFFSET TABLE BEFORE MACHINE ALARM)
(NOTE: IF BLUM ALARMS INTERNALLY VIA O8650, WRAPPER CLEANUP IS)
(SKIPPED. POST PROCESSOR CLEARS #[13000+T]=0 AT NEXT TOOL CHANGE.)
#[13000 + #27] = 0.0000
M159
M5
#3000 = 3 (BLUM LASER MEASUREMENT FAILED)

N9004
(EXCESSIVE WEAR - ZERO OFFSET TABLE BEFORE MACHINE ALARM)
#[13000 + #27] = 0.0000
M159
M5
#3000 = 4 (DIAMETER WEAR EXCEEDS MAX LIMIT)

N9006
#3000 = 6 (TOOL DIA OVER 24MM LASER LIMIT)
