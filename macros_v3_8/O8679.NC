(* REV D 2026-10-18 - BROTHER SPEEDIO C00 PRE-ALARM CLEANUP *)
(*NOTE* THIS PROGRAM CAN BE MODIFIED BY MACHINE TOOL BUILDER OR END USER.)
(USED AT THE END OF ALL BLUM CYCLES)
#115=0
(PRE-ALARM ZERO CUTTER COMP CLEANUP)
IF [#7 EQ #0] GOTO 10
IF [#7 LT 1.] GOTO 10
IF [#7 GT 99.] GOTO 10
#[13000 + FIX[#7]] = 0.0000
N10
IF [#11 EQ #0] GOTO 20
IF [#11 LT 1.] GOTO 20
IF [#11 GT 99.] GOTO 20
#[13000 + FIX[#11]] = 0.0000
N20
IF [#580 EQ #0] GOTO 30
IF [#580 LE 0.] GOTO 30
IF [#580 GT 99.] GOTO 30
#[13000 + FIX[#580]] = 0.0000
#580 = 0.0
N30
M159
IF[#100EQ0]GOTO100
(M5) (MODE M5)
N100 #[#140+9]=#105 (DEFINE X POSITION FOR FAST APPROACH)
IF[#100EQ15]GOTO9995
IF[#100EQ16]GOTO9995
IF[#100EQ19]GOTO9995
M99
N9995 (SET FLAG FOR TOOL BROKEN)
N9999 M99
