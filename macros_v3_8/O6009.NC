(O6009 - LASER NT WEAR AND RUNOUT MACRO - REV D 2026-10-18)
(MACHINE: BROTHER SPEEDIO S500X2 / C00 CONTROLLER)
(SETTER:  BLUM LASER NT - V5DE CYCLES O8603 / O8606 / O8607)
(REV D: B-1.0 WEAR UPDATE MODE - UPDATES #12000+T)
(REV D: B-2.0 CHECK-ONLY MODE - NO TABLE WRITES)
(REV D: NATIVE BLUM #115 RADIUS INJECTION - ZERO COMP GUARANTEE)
(REV D: LOLLIPOP ARC WEAR O8606 AND CONTOUR CHECK O8607)
(REV D: TOOL LENGTH GATE RESTORED. O8603 SKIPS ITS OWN MINIMUM)
(       LENGTH CHECK WHEN THE TABLE LENGTH IS 0 [O8633 N131], THEN)
(       POSITIONS Z FROM #111 = 50MM - A LONGER TOOL IS DRIVEN INTO)
(       THE LASER BODY. THE LENGTH MUST BE SET BEFORE THIS MACRO.)
(REV D: G90 RESTORED ON EXIT. BLUM EXITS IN G91 + G49)
(REV D: ALARMS 9101-9108, MESSAGES MAX 20 CHARACTERS)
(REV D: NO NESTED PARENTHESES IN COMMENTS)
(================================================================)
(RULES:)
(- CALL FROM A MAIN PROGRAM ONLY. THIS MACRO + BLUM USES ALL 4)
(  G65 NESTING LEVELS ALLOWED BY THE C00.)
(- MACHINE UNIT MUST BE METRIC [BLUM ERROR E18].)
(- TOOL LENGTH MUST ALREADY BE MEASURED [Z-NANO OR O6008].)
(- WEAR IS WRITTEN TO #12000+T AS DIAMETER, NEGATIVE = SMALLER.)
(- B-2.0 MODE SKIPS WEAR WRITES AND CHECKS INTEGRITY ONLY.)
(- USES PERSISTENT VARIABLE #580.)
(================================================================)
(CALL FORMAT:)
(  G65 P6009 B.. T.. D.. C.. K.. I.. V.. J.. S.. Q.. U.. A.. R.. Z.. X.. M..)
(ARGUMENTS:)
(  B #2  MODE -1.0 = WEAR UPDATE [DEFAULT])
(        MODE -2.0 = CHECK ONLY / CONTROL MODE, NO WEAR WRITE)
(  T #20 TOOL NUMBER [DEFAULT: SPINDLE TOOL #3700])
(  D #7  NOMINAL TOOL DIAMETER MM [REQUIRED, 0.1 TO 24.0])
(  C #3  NUMBER OF FLUTES [DEFAULT 4])
(  K #6  TOOL TYPE:)
(        0 OR OMITTED = FLAT END MILL)
(        -3 = DRILL / REAMER, MARGIN JUST ABOVE THE POINT)
(        -4 = T-SLOT CUTTER)
(        -5 = LOLLIPOP CUTTER [ARC WEAR VIA O8606 / O8607])
(        K LT 0 OR K GE D/2 = BALL NOSE)
(        0 LT K LT D/2 = BULLNOSE WITH CORNER RADIUS K)
(  I #4  LOLLIPOP START ANGLE DEG [DEFAULT 25.0])
(  V #22 LOLLIPOP END ANGLE DEG [DEFAULT 135.0])
(  J #5  BALL / CORNER RADIUS MM [DEFAULT D/2])
(  S #19 SPINDLE RPM [DEFAULT AND MINIMUM 3000])
(  Q #17 RUNOUT TOLERANCE PER CUTTING EDGE MM [DEFAULT 0.025])
(  U #21 MAX DIAMETER WEAR MM [DEFAULT 0.1])
(  A #1  REPEAT MEASUREMENTS [DEFAULT 3])
(  R #18 REPEAT SPREAD MM [DEFAULT 0.010])
(  Z #26 MEASURING HEIGHT ABOVE THE TIP MM [DEFAULT BY TYPE])
(  X #24 RADIAL POSITION MM [DEFAULT BY TYPE])
(  M #13 1 = LEAVE SPINDLE RUNNING, 0 = STOP [DEFAULT])
(================================================================)
(--- STEP 1: ARGUMENTS ---)
IF [#20 NE #0] GOTO 10
#20 = #3700 (DEFAULT TO SPINDLE TOOL)
N10
#27 = FIX[#20]
IF [#27 LE 0] GOTO 9101
IF [#27 GT 99] GOTO 9101
(MODE B)
IF [#2 NE #0] GOTO 11
#2 = -1.
N11
IF [#2 EQ 1.] GOTO 12
IF [#2 EQ 2.] GOTO 13
GOTO 14
N12
#2 = -1.
GOTO 14
N13
#2 = -2.
N14
IF [#2 EQ -1.] GOTO 15
IF [#2 EQ -2.] GOTO 15
GOTO 9108
N15
(NOMINAL DIAMETER)
IF [#7 EQ #0] GOTO 9102
IF [#7 LE 0.] GOTO 9102
IF [#7 GT 24.] GOTO 9106
(TOOL LENGTH GATE - MUST MATCH O8671 #111 = 50 AND #110 = 200)
IF [#[11000 + #27] LT 50.] GOTO 9107
IF [#[11000 + #27] GT 200.] GOTO 9107
(FLUTES)
IF [#3 EQ #0] GOTO 25
IF [#3 GT 0.] GOTO 26
N25
#3 = 4.
N26
(SPINDLE SPEED, MINIMUM 3000 FOR NT)
IF [#19 EQ #0] GOTO 30
IF [#19 LT 3000.] GOTO 30
GOTO 35
N30
#19 = 3000.
N35
(RUNOUT TOLERANCE Q)
IF [#17 EQ #0] GOTO 40
IF [#17 LE 0.] GOTO 40
GOTO 45
N40
#17 = 0.025
N45
(MAXIMUM DIAMETER WEAR U)
IF [#21 EQ #0] GOTO 50
IF [#21 LE 0.] GOTO 50
GOTO 52
N50
#21 = 0.1
N52
#14 = #21 / 2. (RADIAL TOLERANCE FOR BLUM T AND S ARGUMENTS)
(REPEATS A)
IF [#1 NE #0] GOTO 53
#1 = 3.
N53
(REPEAT SPREAD R)
IF [#18 NE #0] GOTO 54
#18 = 0.01
N54
(SPINDLE EXIT M)
IF [#13 NE #0] GOTO 56
#13 = 0.
N56
(--- STEP 2: TOOL IN SPINDLE ---)
IF [#3700 EQ #27] GOTO 58
G91 G28 Z0. (Z TO REFERENCE BEFORE CANCELLING LENGTH COMP)
G90 G49
T#27 M6
M159
N58
(--- STEP 3: MEASURING HEIGHT Z AND POSITION X ---)
IF [#6 EQ #0] GOTO 60 (FLAT END MILL IF OMITTED)
IF [#6 EQ 0.] GOTO 60 (FLAT END MILL)
IF [ABS[#6 - [-3.]] LT 0.01] GOTO 75 (DRILL / REAMER)
IF [ABS[#6 - [-4.]] LT 0.01] GOTO 78 (T-SLOT CUTTER)
IF [ABS[#6 - [-5.]] LT 0.01] GOTO 85 (LOLLIPOP CUTTER)
IF [#6 LT 0.] GOTO 70 (BALL NOSE)
IF [#6 GE [#7 / 2.]] GOTO 70 (TREATED AS BALL NOSE)
GOTO 80 (BULLNOSE)
(FLAT END MILL: Z = 15 PERCENT OF DIA, 0.08 TO 0.5MM)
N60
IF [#26 NE #0] GOTO 65
#26 = #7 * 0.15
IF [#26 GE 0.08] GOTO 62
#26 = 0.08
N62
IF [#26 LE 0.5] GOTO 65
#26 = 0.5
N65
IF [#24 NE #0] GOTO 100
#24 = [#7 / 2.] * 0.8
GOTO 100
(BALL NOSE: EQUATOR)
N70
IF [#26 NE #0] GOTO 71
#26 = #7 / 2.
N71
IF [#24 NE #0] GOTO 100
#24 = 0.
GOTO 100
(DRILL / REAMER: 118 DEG POINT HEIGHT + 0.5MM)
N75
IF [#26 NE #0] GOTO 76
#26 = [[#7 / 2.] / TAN[59.]] + 0.5
N76
IF [#24 NE #0] GOTO 100
#24 = 0.
GOTO 100
(T-SLOT CUTTER: 1.5MM ABOVE THE BOTTOM UNLESS Z IS GIVEN)
N78
IF [#26 NE #0] GOTO 79
#26 = 1.5
N79
IF [#24 NE #0] GOTO 100
#24 = [#7 / 2.] * 0.8
GOTO 100
(BULLNOSE: Z JUST ABOVE THE CORNER RADIUS)
N80
IF [#26 NE #0] GOTO 81
#26 = #6 + 0.3
N81
IF [#24 NE #0] GOTO 100
#24 = [#7 / 2.] - #6 - 0.5
IF [#24 GE 0.1] GOTO 100
#24 = [[#7 / 2.] - #6] * 0.8
IF [#24 GE 0.] GOTO 100
#24 = 0.
GOTO 100
(LOLLIPOP CUTTER)
N85
IF [#4 NE #0] GOTO 86
#4 = 25. (START ANGLE I DEFAULT 25 DEG)
N86
IF [#22 NE #0] GOTO 87
#22 = 135. (END ANGLE V DEFAULT 135 DEG)
N87
IF [#5 NE #0] GOTO 88
#5 = #7 / 2. (BALL RADIUS J DEFAULT D/2)
N88
GOTO 500
(--- STEP 4: SPINDLE ---)
N100
M3 S#19
M159
G4 X1.5
(--- STEP 5: MEASURE VIA O8603 ---)
#115 = [#7 / 2.] (BLUM RADIUS POSTPROCESSOR DATA IN MM)
#[13000 + #27] = 0.
#580 = 0.
M159
(B-1.0 WEAR UPDATE OR B-2.0 CHECK ONLY, E2 RADIUS ONLY, M-1 ONE SIDE)
G65 P8603 H#27 D#27 B#2 E2. M-1. Z#26 X#24 C#3 Q#17 T#14 A#1 R#18
G90 (BLUM EXITS IN G91)
#115 = 0.
#[13000 + #27] = 0.
#580 = 0.
M159
GOTO 700
(--- LOLLIPOP MEASUREMENT ---)
N500
M3 S#19
M159
G4 X1.5
#115 = [#7 / 2.] (BLUM RADIUS POSTPROCESSOR DATA IN MM)
#[13000 + #27] = 0.
#580 = 0.
M159
IF [ABS[#2] EQ 2.] GOTO 550
(LOLLIPOP B-1.0 WEAR UPDATE VIA O8606)
G65 P8606 H#27 D#27 B#2 M3. C8. I#4 K#22 J#5 S#14 T#14 A#1 R#18
GOTO 580
N550
(LOLLIPOP B-2.0 CHECK-ONLY VIA O8607)
G65 P8607 H#27 D#27 C#3 Q#17 I#4 K#22 J#5 M3. F100.
N580
G90 (BLUM EXITS IN G91)
#115 = 0.
#[13000 + #27] = 0.
#580 = 0.
M159
GOTO 700
(--- STEP 6: RESULT ---)
N700
IF [#100 NE 0] GOTO 9103
IF [ABS[#2] EQ 2.] GOTO 800 (CHECK ONLY - DO NOT CHECK WEAR REGISTER)
#28 = #[12000 + #27] (MEASURED DIAMETER WEAR)
IF [ABS[#28] GT #21] GOTO 9104
N800
IF [#13 NE 0.] GOTO 200
M5
N200
G90
M159
M99
(================================================================)
(ALARMS 9101-9108)
(================================================================)
N9101
#3000=101(INVALID TOOL NUMBER)
N9102
#3000=102(DIA D MISSING)
N9103
#115 = 0.
#[13000 + #27] = 0.
#580 = 0.
M159
M5
#3000=103(BLUM MEAS FAILED)
N9104
#115 = 0.
#[13000 + #27] = 0.
#580 = 0.
M159
M5
#3000=104(WEAR OVER LIMIT)
N9106
#3000=106(DIA OVER 24MM)
N9107
#3000=107(NO VALID TOOL LEN)
N9108
#3000=108(BAD MODE B)
